# Neon Postgres — inject via env / shared-box / Vercel. Do not commit a real URL.
# Side Quests injects Auth0 + Neon on Vercel — never invent secret values.
DATABASE_URL=

# Auth0 Regular Web Application (email + Google only).
# Leave AUTH0_SECRET and AUTH0_CLIENT_SECRET empty here — inject via
# shared-box / Vercel. Never invent or commit real secret values.
#
# Callback path is the v4 default: /auth/callback
#   Local:      http://localhost:3000/auth/callback
#   Production: https://5-1-mentor.vercel.app/auth/callback
#               (Vercel project 5-1-mentor)

AUTH0_SECRET=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=focusotter-demos.us.auth0.com
AUTH0_CLIENT_ID=ZNevIeCZyDRADUp1zQ3811oIJp14BcVS

# Local development. On Vercel production, Side Quests sets
# APP_BASE_URL=https://5-1-mentor.vercel.app
APP_BASE_URL=http://localhost:3000

# Optional aliases accepted by lib/auth0.ts
AUTH0_ISSUER_BASE_URL=https://focusotter-demos.us.auth0.com
AUTH0_BASE_URL=http://localhost:3000
